# ───────── Base de datos (Supabase → Project Settings → Database) ─────────
# Conexión por pooler (puerto 6543, transaction mode) — la usa la app en runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432) — la usa Prisma para migraciones
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ───────── Supabase (Project Settings → API) ─────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SOLO servidor. Nunca exponer en el cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Bucket de Storage para PDFs e imágenes (se crea solo si no existe)
SUPABASE_STORAGE_BUCKET="transgas-public"

# ───────── Sitio ─────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Chatbot ─────────
# Hoy solo acepta "rules". Ver src/lib/chat/engine.ts
CHAT_ENGINE="rules"
# Número de WhatsApp en formato internacional, solo dígitos (ej. Argentina móvil: 549 + área + número)
WHATSAPP_NUMBER="5493385000000"
EMERGENCY_PHONE_DISPLAY="0800-777-8427"
EMERGENCY_PHONE_TEL="08007778427"

# ───────── Seed: primer usuario admin del CRM ─────────
SEED_ADMIN_EMAIL="admin@transgas.local"
SEED_ADMIN_PASSWORD="cambiar-esta-clave-123"

# ───────── Buscadores (Google) ─────────
# Dejalo VACÍO o en "false" en el dominio de prueba (pide a Google no indexar el sitio).
# Poné "true" SOLO cuando el sitio esté en el dominio definitivo (transgas.com.ar).
ALLOW_INDEXING="false"

# ───────── Mail (Fase 2) ─────────
# Servidor de correo SMTP, por ejemplo el correo del dominio en Hostinger (hPanel → Correos electrónicos → Configurar).
# Se usa para: avisos de contactos nuevos al equipo, confirmación de suscripciones y avisos de vencimiento.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Transgas <no-responder@transgas.com.ar>"
# Casillas que reciben el aviso de cada contacto nuevo (también se editan en CRM → Configuración)
NOTIFY_EMAILS=""
# Correo para ejercer derechos sobre datos personales (se muestra en la Política de Privacidad; editable en el CRM)
PRIVACY_EMAIL=""

# ───────── Avisos automáticos de vencimiento ─────────
# Clave secreta del "Cron Job" (hPanel → Avanzado → Cron Jobs). Inventá una larga y aleatoria.
CRON_SECRET=""
# Máximo de mails por ejecución (protege el límite horario del servidor de correo)
NOTICE_BATCH="100"

# ───────── Estadísticas ─────────
# Secreto para el hash anónimo de visitas (opcional; si falta se usa otro valor interno)
TRACK_SECRET=""
