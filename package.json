{
  "name": "transgas-web",
  "version": "0.1.0",
  "private": true,
  "description": "Transgas — sitio público, CRM y chatbot (Fase 1)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/chat/ruleBasedEngine.test.ts src/lib/leads/config.test.ts src/content/pages.test.ts src/lib/tariffRanges.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:faqs": "tsx prisma/seed.ts --update-faqs",
    "db:seed:news": "tsx prisma/seed.ts --update-news",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/pm": "^3.30.4",
    "@tiptap/react": "^3.30.4",
    "@tiptap/starter-kit": "^3.30.4",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.7",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "glob": "^10.5.0",
    "postcss-selector-parser": "^7.1.6"
  }
}
